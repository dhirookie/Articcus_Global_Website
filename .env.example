# Public canonical origin, used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://articcus.com

# Set these on the server to receive enquiries. Never prefix these with NEXT_PUBLIC_.
# The receiver must accept JSON POSTs and return 2xx only after accepting the lead.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Optional HTTPS scheduling page. Empty uses the short enquiry form.
NEXT_PUBLIC_BOOKING_URL=

# Set only to a header your trusted proxy strips and supplies (for per-visitor limits).
LEAD_CLIENT_IP_HEADER=

# Optional measurement receiver. Leave empty to disable measurement entirely.
# Set before building/deploying to enable the consent interface on prerendered pages.
# When configured, visitors are asked for permission before any events are sent.
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_TOKEN=
